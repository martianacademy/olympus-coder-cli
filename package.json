  "description": "Olympus Coder CLI — standalone multi-model coding agent and native Agent Client Protocol (ACP) v2.6 server.",
  "license": "Apache-2.0",
  "author": "Martian Academy",
  "type": "module",
  "bin": {
    "olympus": "bin/olympus.js"
  },
